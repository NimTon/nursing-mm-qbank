# 多模态 VLM（整页读图）
VLM_BASE_URL=https://api.openai.com/v1
VLM_API_KEY=
VLM_MODEL=gpt-4o
# 阿里云 DashScope（compatible-mode/v1）示例：VLM_MODEL=qwen-vl-max

# 纯文本 LLM（拆题、教材修正、讲课内容）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 阿里云 DashScope 示例：LLM_MODEL=qwen-plus 或 qwen3-max

# 模型名统一在 .env 配置；configs/default.yaml 仅保留温度、并发等参数
# 填好后可运行：mm-qbank verify-config
