# --- 在线模型：OpenAI 兼容，含阿里云百炼（llm-compose / vlm-text / vlm-refine 共用）---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
# 多模态整页转写 vlm-text：须为支持图片的模型
# OPENAI_MM_MODEL=gpt-4o

# 百炼示例：DASHSCOPE_API_KEY + compatible-mode base；未设模型时文本默认 qwen-plus、多模态默认 qwen-vl-plus
# DASHSCOPE_API_KEY=
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_TEXT_MODEL=qwen-plus
# OPENAI_MM_MODEL=qwen-vl-plus

# DeepSeek（OpenAI 格式）：https://api-docs.deepseek.com/zh-cn/
# 与百炼并存：主 OPENAI_* 仍指向百炼做 VLM；设 DEEPSEEK_API_KEY 后，llm-compose / vlm-refine 自动走 DeepSeek（无需改 OPENAI_BASE_URL）。
# DEEPSEEK_API_KEY=
# TEXT_LLM_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 或完全自定义文本网关：TEXT_LLM_BASE_URL= + TEXT_LLM_API_KEY= + TEXT_LLM_MODEL=
# 若「全部」只走 DeepSeek：OPENAI_BASE_URL=https://api.deepseek.com 且 OPENAI_API_KEY=DeepSeek 的 key 即可
# 文本/拆题等默认会匹配为 deepseek-v4-pro，也可显式设：
# OPENAI_TEXT_MODEL=deepseek-v4-pro
# OPENAI_TEXT_MODEL=deepseek-v4-flash
# 若同一条 base_url 上 VLM 需其它多模态模型，请另设：
# OPENAI_MM_MODEL=...
